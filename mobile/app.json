{
  "expo": {
    "name": "Elovanta",
    "slug": "elovanta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "elovanta",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elovanta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Elovanta needs your camera so your tutor can see you during live classes.",
        "NSMicrophoneUsageDescription": "Elovanta needs your microphone so you can talk during live classes."
      }
    },
    "android": {
      "package": "com.elovanta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7A1A"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F2"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Elovanta needs your camera so your tutor can see you during live classes.",
          "microphonePermission": "Elovanta needs your microphone so you can talk during live classes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
