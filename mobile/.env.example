# "localhost" only works in an iOS Simulator / Android Emulator running on the
# SAME machine as the backend. For a physical phone on the same Wi-Fi, use your
# computer's LAN IP instead, e.g. http://192.168.1.50:5000/api
# Simplest option: point straight at your deployed Render backend (works from anywhere):
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com/api
