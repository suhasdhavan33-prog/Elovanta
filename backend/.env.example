PORT=5000

# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/elovanta
# MongoDB Atlas (cloud) — from Atlas: Database > Connect > Drivers:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/elovanta?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
